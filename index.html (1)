    // ---------- Data loaders ----------
    async function loadOverview() {
      try {
        const [cats, courses, users, questions, contacts, anns, access] = await Promise.all([
          getDocs(collection(db, "categories")),
          getDocs(query(collection(db, "courses"), where("status", "==", "published"))),
          getDocs(collection(db, "users")),
          getDocs(collection(db, "questionBank")),
          getDocs(query(collection(db, "contactRequests"), where("status", "==", "new"))),
          getDocs(collection(db, "announcements")),
          getDocs(query(collection(db, "courseAccess"), where("status", "==", "pending"))).catch(() => ({ size: 0, docs: [] }))
        ]);
        $("statCategories").textContent = cats.size;
        $("statCourses").textContent = courses.size;
        let students = 0, teachers = 0;
        users.forEach(d => {
          const r = String(d.data().role || "").toLowerCase();
          if (r === "student") students++;
          if (r === "teacher") teachers++;
        });
        $("statStudents").textContent = students;
        $("statTeachers").textContent = teachers;
        $("statQuestions").textContent = questions.size;
        $("statContacts").textContent = contacts.size;
        $("statAnnouncements").textContent = anns.size;
        $("statPendingAccess").textContent = access.size || 0;

        // Simple bar chart for course statuses
        const allCourses = await getDocs(collection(db, "courses"));
        let published = 0, draft = 0, archived = 0;
        allCourses.forEach(d => {
          const s = d.data().status || "draft";
          if (s === "published") published++;
          else if (s === "archived") archived++;
          else draft++;
        });
        const max = Math.max(published, draft, archived, 1);
        $("chartCourseStatus").innerHTML = `
          <div class="bar-item"><div class="bar" style="height:${(published/max)*100}%"></div><span class="bar-label">Published<br>${published}</span></div>
          <div class="bar-item"><div class="bar" style="height:${(draft/max)*100}%"></div><span class="bar-label">Draft<br>${draft}</span></div>
          <div class="bar-item"><div class="bar" style="height:${(archived/max)*100}%"></div><span class="bar-label">Archived<br>${archived}</span></div>
        `;

        // Recent contacts as activity
        const recent = await getDocs(query(collection(db, "contactRequests"), orderBy("createdAt", "desc"), limit(5))).catch(() => null);
        if (recent && !recent.empty) {
          let html = "<ul style='list-style:none;font-size:0.85rem;'>";
          recent.forEach(d => {
            const c = d.data();
            html += `<li style="padding:8px 0;border-bottom:1px solid var(--border);"><strong>${escapeHtml(c.fullName)}</strong> — ${escapeHtml(c.subject || "Contact")} <span style="color:var(--text-muted);">${formatDate(c.createdAt)}</span></li>`;
          });
          html += "</ul>";
          $("recentActivity").innerHTML = html;
        } else {
          $("recentActivity").innerHTML = "<p class='empty-state'>No recent activity yet.</p>";
        }
      } catch (e) {
        console.error(e);
        toast("Could not load overview stats.", "error");
      }
    }

