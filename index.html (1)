      loadSimpleCollection("subjects", "subjectsTable", 5, (id, s) => `<tr>
        <td><strong>${escapeHtml(s.name || "—")}</strong></td>
        <td>${escapeHtml(s.courseTitle || "—")}</td>
        <td>${s.topicCount ?? (s.topics?.length || 0)}</td>
        <td><span class="badge badge-success">Active</span></td>
        <td class="actions"><button class="btn btn-sm btn-danger" data-id="${id}" onclick="this.closest('tr').remove()">Delete</button></td>
      </tr>`);
    }
    $("btnAddSubject").addEventListener("click", () => {
      openModal("Add Subject", `
        <div class="form-group"><label>Subject Name *</label><input id="fName" /></div>
        <div class="form-group"><label>Course Title</label><input id="fCourse" /></div>
        <div class="form-group"><label>Topics (comma-separated)</label><input id="fTopics" placeholder="Topic 1, Topic 2" /></div>
      `, async () => {
        const name = $("fName").value.trim();
        if (!name) return toast("Name required", "error");
        const topics = $("fTopics").value.split(",").map(t => t.trim()).filter(Boolean);
        await addDoc(collection(db, "subjects"), {
          name, courseTitle: $("fCourse").value.trim(), topics, topicCount: topics.length, createdAt: serverTimestamp()
        });
        toast("Subject added", "success");
        closeModal();
        loadSubjects();
      });
    });

    function loadAssignments() {
      loadSimpleCollection("assignments", "assignmentsTable", 5, (id, a) => `<tr>
        <td><strong>${escapeHtml(a.title || "—")}</strong></td>
        <td>${escapeHtml(a.courseTitle || "—")}</td>
        <td>${formatDate(a.dueDate)}</td>
        <td><span class="badge badge-info">${a.status || "open"}</span></td>
        <td class="actions"><button class="btn btn-sm btn-danger btn-del-asg" data-id="${id}">Delete</button></td>
      </tr>`);
    }
    $("btnAddAssignment").addEventListener("click", () => {
      openModal("Add Assignment", `
        <div class="form-group"><label>Title *</label><input id="fTitle" /></div>
        <div class="form-group"><label>Course</label><input id="fCourse" /></div>
        <div class="form-group"><label>Due Date</label><input type="date" id="fDue" /></div>
        <div class="form-group"><label>Instructions</label><textarea id="fInst"></textarea></div>
      `, async () => {
        const title = $("fTitle").value.trim();
        if (!title) return toast("Title required", "error");
        await addDoc(collection(db, "assignments"), {
          title, courseTitle: $("fCourse").value.trim(), dueDate: $("fDue").value || null,
          instructions: $("fInst").value.trim(), status: "open", createdAt: serverTimestamp()
        });
        toast("Assignment created", "success");
        closeModal();
        loadAssignments();
      });
    });

    function loadCertificates() {
      loadSimpleCollection("certificates", "certificatesTable", 5, (id, c) => `<tr>
        <td>${escapeHtml(c.studentName || "—")}</td>
        <td>${escapeHtml(c.courseTitle || "—")}</td>
        <td>${formatDate(c.issuedAt)}</td>
        <td><code>${escapeHtml(c.certificateId || id.slice(0,8))}</code></td>
        <td class="actions"><button class="btn btn-sm btn-ghost">View</button></td>
      </tr>`);
    }
    $("btnIssueCert").addEventListener("click", () => {
      openModal("Issue Certificate", `
        <div class="form-group"><label>Student Name *</label><input id="fStudent" /></div>
        <div class="form-group"><label>Course Title *</label><input id="fCourse" /></div>
      `, async () => {
        const studentName = $("fStudent").value.trim();
        const courseTitle = $("fCourse").value.trim();
        if (!studentName || !courseTitle) return toast("Both fields required", "error");
        const certificateId = "ME-" + Date.now().toString(36).toUpperCase();
        await addDoc(collection(db, "certificates"), {
          studentName, courseTitle, certificateId, issuedAt: serverTimestamp(), issuedBy: currentUser?.uid
        });
        toast("Certificate issued: " + certificateId, "success");
        closeModal();
        loadCertificates();
      });
    });

    function loadPayments() {
      loadSimpleCollection("payments", "paymentsTable", 6, (id, p) => `<tr>
        <td>${escapeHtml(p.studentName || p.studentEmail || "—")}</td>
        <td>${escapeHtml(p.item || p.courseTitle || "—")}</td>
        <td>${escapeHtml(String(p.amount ?? "—"))} ${escapeHtml(p.currency || "")}</td>
        <td><span class="badge ${p.status==="completed"?"badge-success":p.status==="failed"?"badge-danger":"badge-warning"}">${p.status||"pending"}</span></td>
        <td>${formatDate(p.createdAt)}</td>
        <td class="actions">—</td>
      </tr>`);
    }

    function loadForum() {
      loadSimpleCollection("forumTopics", "forumTable", 5, (id, t) => `<tr>
        <td><strong>${escapeHtml(t.title || "—")}</strong></td>
        <td>${escapeHtml(t.authorName || "—")}</td>
        <td>${t.replyCount ?? 0}</td>
        <td><span class="badge ${t.isLocked?"badge-danger":"badge-success"}">${t.isLocked?"Locked":"Open"}</span></td>
        <td class="actions">
          <button class="btn btn-sm btn-ghost btn-lock-forum" data-id="${id}" data-locked="${!!t.isLocked}">${t.isLocked?"Unlock":"Lock"}</button>
        </td>
      </tr>`);
    }

    function loadNotifications() {
      loadSimpleCollection("notifications", "notificationsTable", 4, (id, n) => `<tr>
        <td><strong>${escapeHtml(n.title || "—")}</strong></td>
        <td>${escapeHtml(n.audience || "all")}</td>
        <td>${formatDate(n.createdAt)}</td>
        <td class="actions"><button class="btn btn-sm btn-danger btn-del-notif" data-id="${id}">Delete</button></td>
      </tr>`);
    }
    $("btnSendNotification").addEventListener("click", () => {
      openModal("Send Notification", `
        <div class="form-group"><label>Title *</label><input id="fTitle" /></div>
        <div class="form-group"><label>Message *</label><textarea id="fMsg" rows="4"></textarea></div>
        <div class="form-group"><label>Audience</label><select id="fAud"><option value="all">All users</option><option value="students">Students</option><option value="teachers">Teachers</option></select></div>
      `, async () => {
        const title = $("fTitle").value.trim();
        const message = $("fMsg").value.trim();
        if (!title || !message) return toast("Title and message required", "error");
        await addDoc(collection(db, "notifications"), {
          title, message, audience: $("fAud").value, createdAt: serverTimestamp(), createdBy: currentUser?.uid
        });
        toast("Notification sent", "success");
        closeModal();
        loadNotifications();
      });
    });

    function loadNav() {
      loadSimpleCollection("navigation", "navTable", 5, (id, n) => `<tr>
        <td>${escapeHtml(n.label || "—")}</td>
        <td>${escapeHtml(n.url || "—")}</td>
        <td>${n.order ?? 0}</td>
        <td>${n.visible !== false ? "Yes" : "No"}</td>
        <td class="actions"><button class="btn btn-sm btn-danger btn-del-nav" data-id="${id}">Delete</button></td>
      </tr>`);
    }
    $("btnAddNav").addEventListener("click", () => {
      openModal("Add Nav Link", `
        <div class="form-group"><label>Label *</label><input id="fLabel" /></div>
        <div class="form-group"><label>URL / Anchor *</label><input id="fUrl" placeholder="#about or /page" /></div>
        <div class="form-group"><label>Order</label><input type="number" id="fOrder" value="0" /></div>
      `, async () => {
        const label = $("fLabel").value.trim();
        const url = $("fUrl").value.trim();
        if (!label || !url) return toast("Label and URL required", "error");
        await addDoc(collection(db, "navigation"), {
          label, url, order: Number($("fOrder").value) || 0, visible: true, createdAt: serverTimestamp()
        });
        toast("Link added", "success");
        closeModal();
        loadNav();
      });
    });

    // Roles
    async function loadRoles() {
      const tbody = $("rolesTable");
      tbody.innerHTML = `<tr><td colspan="5" class="loading"><div class="spinner"></div></td></tr>`;
      try {
        const snap = await getDocs(collection(db, "users"));
        let html = "";
        snap.forEach(d => {
          const u = d.data();
          const role = (u.role || "student").toLowerCase();
          if (role === "super_admin") {
            html += `<tr><td>${escapeHtml(u.fullName||"—")}</td><td>${escapeHtml(u.email||"—")}</td><td><span class="badge badge-info">super_admin</span></td><td>—</td><td>—</td></tr>`;
            return;
          }
          html += `<tr>
            <td>${escapeHtml(u.fullName||"—")}</td>
            <td>${escapeHtml(u.email||"—")}</td>
            <td><span class="badge badge-muted">${role}</span></td>
            <td>
              <select class="filter-select role-select" data-id="${d.id}" style="min-width:120px;">
                <option value="student" ${role==="student"?"selected":""}>student</option>
                <option value="teacher" ${role==="teacher"?"selected":""}>teacher</option>
                <option value="admin" ${role==="admin"?"selected":""}>admin</option>
              </select>
            </td>
            <td><button class="btn btn-sm btn-primary btn-save-role" data-id="${d.id}">Save</button></td>
          </tr>`;
        });
        tbody.innerHTML = html || `<tr><td colspan="5"><div class="empty-state"><p>No users.</p></div></td></tr>`;
        document.querySelectorAll(".btn-save-role").forEach(btn => {
          btn.onclick = async () => {
            const sel = document.querySelector(`.role-select[data-id="${btn.dataset.id}"]`);
            await updateDoc(doc(db, "users", btn.dataset.id), { role: sel.value, updatedAt: serverTimestamp() });
            toast("Role updated", "success");
            loadRoles();
          };
        });
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="5">Error loading users.</td></tr>`;
      }
    }

    // Audit (placeholder from a collection if exists)
    async function loadAudit() {
      const tbody = $("auditTable");
      try {
        const snap = await getDocs(query(collection(db, "auditLogs"), orderBy("createdAt", "desc"), limit(50)));
        if (snap.empty) throw new Error("empty");
        let html = "";
        snap.forEach(d => {
          const a = d.data();
          html += `<tr><td>${escapeHtml(a.userEmail || a.userId || "—")}</td><td>${escapeHtml(a.action || "—")}</td><td>${escapeHtml(a.ip || a.device || "—")}</td><td>${formatDate(a.createdAt)}</td></tr>`;
        });
        tbody.innerHTML = html;
      } catch {
        tbody.innerHTML = `<tr><td colspan="4"><div class="empty-state"><p>No audit logs yet. Logs will appear when the system records login and admin actions.</p></div></td></tr>`;
      }
    }

    // Settings loaders
    async function loadSiteSettings() {
      try {
        const snap = await getDoc(doc(db, "system", "siteSettings"));
        if (!snap.exists()) return;
        const s = snap.data();
        if (s.heroTitle) $("heroTitle").value = s.heroTitle;
        if (s.heroSlogan) $("heroSlogan").value = s.heroSlogan;
        if (s.heroDesc) $("heroDesc").value = s.heroDesc;
        if (s.aboutText) $("aboutText").value = s.aboutText;
        if (s.missionText) $("missionText").value = s.missionText;
        if (s.visionText) $("visionText").value = s.visionText;
        if (s.footerTagline) $("footerTagline").value = s.footerTagline;
        if (s.footerEmail) $("footerEmail").value = s.footerEmail;
        if (s.siteName) $("siteName").value = s.siteName;
        if (s.defaultLang) $("defaultLang").value = s.defaultLang;
      } catch (e) { console.warn(e); }
    }

    $("btnSaveHomepage").addEventListener("click", async () => {
      await setDoc(doc(db, "system", "siteSettings"), {
        heroTitle: $("heroTitle").value.trim(),
        heroSlogan: $("heroSlogan").value.trim(),
        heroDesc: $("heroDesc").value.trim(),
        showFeatured: $("showFeatured").value === "true",
        updatedAt: serverTimestamp()
      }, { merge: true });
      toast("Homepage settings saved", "success");
    });
    $("btnSaveContent").addEventListener("click", async () => {
      await setDoc(doc(db, "system", "siteSettings"), {
        aboutText: $("aboutText").value.trim(),
        missionText: $("missionText").value.trim(),
        visionText: $("visionText").value.trim(),
        footerTagline: $("footerTagline").value.trim(),
        footerEmail: $("footerEmail").value.trim(),
        updatedAt: serverTimestamp()
      }, { merge: true });
      toast("Content saved", "success");
    });
    $("btnSaveBranding").addEventListener("click", async () => {
      await setDoc(doc(db, "system", "siteSettings"), {
        siteName: $("siteName").value.trim(),
        colorPrimary: $("colorPrimary").value,
        colorSecondary: $("colorSecondary").value,
        colorEmerald: $("colorEmerald").value,
        logoUrl: $("logoUrl").value.trim(),
        updatedAt: serverTimestamp()
      }, { merge: true });
      toast("Branding saved", "success");
    });
    $("btnSaveLangs").addEventListener("click", async () => {
      await setDoc(doc(db, "system", "siteSettings"), {
        defaultLang: $("defaultLang").value, updatedAt: serverTimestamp()
      }, { merge: true });
      toast("Language settings saved", "success");
    });
    $("btnSaveSecurity").addEventListener("click", async () => {
      await setDoc(doc(db, "system", "securitySettings"), {
        requireEmailVerify: $("secEmailVerify").value === "true",
        maxFailedAttempts: Number($("secMaxAttempts").value) || 5,
        sessionTimeoutMinutes: Number($("secSessionTimeout").value) || 60,
        updatedAt: serverTimestamp()
      }, { merge: true });
      toast("Security settings saved", "success");
    });
    $("btnSaveProfile").addEventListener("click", async () => {
      if (!currentUser) return;
      const fullName = $("profileName").value.trim();
      await setDoc(doc(db, "users", currentUser.uid), { fullName, updatedAt: serverTimestamp() }, { merge: true });
      document.getElementById("adminName").textContent = fullName || currentUser.email;
      toast("Profile updated", "success");
    });

    // Backup
    async function backupCollection(name) {
      const snap = await getDocs(collection(db, name));
      const data = [];
      snap.forEach(d => data.push({ id: d.id, ...d.data() }));
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `mmsayaya-${name}-backup-${new Date().toISOString().slice(0,10)}.json`;
      a.click();
      toast(`Downloaded ${data.length} ${name} records`, "success");
    }
    $("btnBackupCategories").onclick = () => backupCollection("categories");
    $("btnBackupCourses").onclick = () => backupCollection("courses");
    $("btnBackupQuestions").onclick = () => backupCollection("questionBank");

    // Analytics export
    $("btnExportUsers").onclick = async () => {
      const snap = await getDocs(collection(db, "users"));
      let csv = "fullName,email,role,status\n";
      snap.forEach(d => {
        const u = d.data();
        csv += `"${(u.fullName||"").replace(/"/g,'""')}","${u.email||""}","${u.role||""}","${u.status||""}"\n`;
      });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
      a.download = "users-export.csv";
      a.click();
    };
    $("btnExportCourses").onclick = async () => {
      const snap = await getDocs(collection(db, "courses"));
      let csv = "title,category,status,difficulty\n";
      snap.forEach(d => {
        const c = d.data();
        csv += `"${(c.title||"").replace(/"/g,'""')}","${c.categoryName||""}","${c.status||""}","${c.difficulty||""}"\n`;
      });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
      a.download = "courses-export.csv";
      a.click();
    };

    // Search filters (client-side simple)
    function bindSearch(inputId, tableId) {
      const input = $(inputId);
      if (!input) return;
      input.addEventListener("input", () => {
        const q = input.value.toLowerCase();
        $(tableId)?.querySelectorAll("tbody tr").forEach(tr => {
          tr.style.display = tr.textContent.toLowerCase().includes(q) ? "" : "none";
        });
      });
    }
    ["catSearch","courseSearch","studentSearch","teacherSearch","qSearch","examSearch","accessSearch","paymentSearch","roleSearch","subjectSearch","lessonSearch"].forEach(id => {
      const tableMap = {
        catSearch: "categoriesTable", courseSearch: "coursesTable", studentSearch: "studentsTable",
        teacherSearch: "teachersTable", qSearch: "questionsTable", examSearch: "examsTable",
        accessSearch: "accessTable", paymentSearch: "paymentsTable", roleSearch: "rolesTable",
        subjectSearch: "subjectsTable", lessonSearch: "lessonsTable"
      };
      bindSearch(id, tableMap[id]);
    });

    // View data router
    function loadViewData(name) {
      switch (name) {
        case "overview": loadOverview(); break;
        case "categories": loadCategories(); break;
        case "courses": loadCourses(); break;
        case "students": loadUsersByRole("student", "studentsTable"); break;
        case "teachers": loadUsersByRole("teacher", "teachersTable"); break;
        case "announcements": loadAnnouncements(); break;
        case "contacts": loadContacts(); break;
        case "questions": loadQuestions(); break;
        case "access": loadAccess(); break;
        case "exams": loadExams(); break;
        case "lessons": loadLessons(); break;
        case "subjects": loadSubjects(); break;
        case "assignments": loadAssignments(); break;
        case "certificates": loadCertificates(); break;
        case "payments": loadPayments(); break;
        case "forum": loadForum(); break;
        case "notifications": loadNotifications(); break;
        case "navigation": loadNav(); break;
        case "roles": loadRoles(); break;
        case "audit": loadAudit(); break;
        case "homepage":
        case "content":
        case "branding":
        case "languages": loadSiteSettings(); break;
        case "analytics":
          loadOverview().then(() => {
            $("anTotalUsers").textContent = (Number($("statStudents").textContent)||0) + (Number($("statTeachers").textContent)||0);
            $("anActiveStudents").textContent = $("statStudents").textContent;
            $("anCompleted").textContent = "—";
            $("anExams").textContent = "—";
          });
          break;
        default: break;
      }
    }
  
  </script>
</body>
</html>
