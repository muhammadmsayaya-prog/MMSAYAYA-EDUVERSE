    // Bulk import
    $("importFile").addEventListener("change", () => {
      $("btnImport").disabled = !$("importFile").files.length;
    });
    (async () => {
      const opts = await getCategoryOptions();
      $("importCategory").innerHTML = opts;
    })();
    $("btnImport").addEventListener("click", async () => {
      const file = $("importFile").files[0];
      if (!file) return;
      const text = await file.text();
      const lines = text.split(/\r?\n/).filter(l => l.trim());
      if (lines.length < 2) return toast("CSV needs a header and at least one row", "error");
      const headers = lines[0].split(",").map(h => h.trim().toLowerCase().replace(/['"]/g, ""));
      const idx = (name) => headers.indexOf(name);
      let ok = 0, fail = 0;
      $("btnImport").disabled = true;
      $("btnImport").textContent = "Importing…";
      for (let i = 1; i < lines.length; i++) {
        const cols = lines[i].match(/("([^"]|"")*"|[^,]*)/g)?.map(c => c.replace(/^"|"$/g, "").replace(/""/g, '"').trim()) || lines[i].split(",");
        try {
          const question = cols[idx("question")] || cols[0];
          if (!question) { fail++; continue; }
          await addDoc(collection(db, "questionBank"), {
            question,
            optionA: cols[idx("optiona")] || cols[1] || "",
            optionB: cols[idx("optionb")] || cols[2] || "",
            optionC: cols[idx("optionc")] || cols[3] || "",
            optionD: cols[idx("optiond")] || cols[4] || "",
            correctAnswer: (cols[idx("correctanswer")] || cols[5] || "A").toUpperCase().charAt(0),
            categoryName: cols[idx("category")] || $("importCategory").selectedOptions[0]?.text || "",
            categoryId: $("importCategory").value || null,
            difficulty: cols[idx("difficulty")] || "Medium",
            type: (cols[idx("type")] || "mcq").toLowerCase(),
            createdAt: serverTimestamp()
          });
          ok++;
        } catch { fail++; }
      }
      $("btnImport").disabled = false;
      $("btnImport").textContent = "Import Questions";
      $("importResult").innerHTML = `<p class="badge badge-success">Imported: ${ok}</p> ${fail ? `<p class="badge badge-danger">Failed: ${fail}</p>` : ""}`;
      toast(`Imported ${ok} questions`, "success");
      loadOverview();
    });

