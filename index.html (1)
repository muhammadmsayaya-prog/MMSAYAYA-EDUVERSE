<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-app.js";
    import { getAnalytics, isSupported } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-analytics.js";
    import { getAuth, signInWithEmailAndPassword, createUserWithEmailAndPassword, sendPasswordResetEmail, signOut } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-auth.js";
    import { getFirestore, collection, getDocs, addDoc, query, where, orderBy, limit, serverTimestamp, doc, getDoc, writeBatch } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: "AIzaSyBlEw1Pb5HzIePo5SlolYm9ofvCUSBS0wM",
      authDomain: "mmsayaya-academy.firebaseapp.com",
      projectId: "mmsayaya-academy",
      storageBucket: "mmsayaya-academy.firebasestorage.app",
      messagingSenderId: "261003419792",
      appId: "1:261003419792:web:9710d497a942a92c10b815",
      measurementId: "G-0N2Q1V11LG"
    };

    const app = initializeApp(firebaseConfig);
    isSupported().then(ok => { if (ok) getAnalytics(app); }).catch(() => {});
    const db = getFirestore(app);

    const categoryIcons = {
      "computer science":"💻","information technology":"🖥️","mathematics":"📐",
      "software development":"⚙️","web development":"🌐","data science":"📊",
      "networking":"📡","cybersecurity":"🔐","artificial intelligence":"🤖",
      "database":"💾","islamic studies":"📖"
    };

    function getIcon(name) {
      const key = (name||"").toLowerCase();
      for (const [k,icon] of Object.entries(categoryIcons)) { if (key.includes(k)) return icon; }
      return "📚";
    }

    document.getElementById("mobileMenuBtn").addEventListener("click", () => {
      document.getElementById("mobileNav").classList.toggle("show");
    });

    async function loadCategories() {
      try {
        const snap = await getDocs(query(collection(db,"categories"), where("isActive","==",true), orderBy("order","asc")));
        if (snap.empty) return;
        let html = "";
        snap.forEach(d => {
          const c = d.data();
          html += `<div class="category-card" onclick="window.location.href='course.html?category=${d.id}'"><div class="category-icon">${getIcon(c.name)}</div><h3>${c.name||"Category"}</h3><p>${(c.description||"Explore courses").substring(0,50)}</p><div class="category-count">Explore →</div></div>`;
        });
        document.getElementById("categoriesGrid").innerHTML = html;
        document.getElementById("statCategories").textContent = snap.size;
      } catch(e) { console.log("Categories fallback:", e.message); }
    }

    async function loadCourses() {
      try {
        const snap = await getDocs(query(collection(db,"courses"), where("status","==","published"), limit(12)));
        document.getElementById("statCourses").textContent = snap.size;
        if (snap.empty) return;
        let featuredHtml="", popularHtml="", i=0;
        snap.forEach(d => {
          const c = d.data();
          const card = `<div class="course-card" onclick="window.location.href='course.html?id=${d.id}'"><div class="course-img">${(c.title||"C").charAt(0)}</div><div class="course-body"><div class="course-cat">${c.categoryName||"General"}</div><h3>${c.title||"Untitled"}</h3><p>${c.shortDescription||c.description||""}</p><div class="course-meta"><span>📊 ${c.difficulty||"All Levels"}</span><span>⏱ ${c.duration||"Self-paced"}</span></div><span class="btn btn-outline" style="padding:7px 14px;font-size:0.8rem;">View Course</span></div></div>`;
          if (c.isFeatured || i<3) featuredHtml += card;
          if (c.isPopular || i<6) popularHtml += card;
          i++;
        });
        if (featuredHtml) document.getElementById("featuredCourses").innerHTML = featuredHtml;
        if (popularHtml) document.getElementById("popularCourses").innerHTML = popularHtml;
      } catch(e) { console.log("Courses:", e.message); }
    }

    async function loadAnnouncements() {
      try {
        const snap = await getDocs(query(collection(db,"announcements"), where("isPublished","==",true), orderBy("createdAt","desc"), limit(5)));
        document.getElementById("statAnnouncements").textContent = snap.size;
        if (snap.empty) return;
        let html = "";
        snap.forEach(d => {
          const a = d.data();
          const date = a.createdAt ? new Date(a.createdAt.toDate()) : new Date();
          html += `<div class="announcement-item"><div class="ann-date">${date.getDate()}<br>${date.toLocaleString("en",{month:"short"})}</div><div><h4>${a.title||"Announcement"}</h4><p>${(a.content||"").substring(0,120)}...</p></div></div>`;
        });
        document.getElementById("announcementsList").innerHTML = html;
      } catch(e) { console.log("Announcements:", e.message); }
    }

    async function loadStats() {
      try {
        const snap = await getDocs(collection(db,"questionBank"));
        document.getElementById("statQuestions").textContent = snap.size;
      } catch(e) {}
    }

    document.getElementById("contactSubmitBtn").addEventListener("click", async () => {
      const fullName = document.getElementById("contactName").value.trim();
      const email = document.getElementById("contactEmailInput").value.trim();
      const subject = document.getElementById("contactSubject").value.trim();
      const message = document.getElementById("contactMessage").value.trim();
      const alertEl = document.getElementById("contactAlert");
      if (!fullName||!email||!subject||!message) { alertEl.textContent="Please fill in all fields."; alertEl.className="form-alert error show"; return; }
      try {
        await addDoc(collection(db,"contactRequests"), { fullName, email, phone:null, subject, message, status:"new", createdAt:serverTimestamp(), repliedAt:null, repliedBy:null });
        alertEl.textContent="Message sent successfully! Admin will get back to you.";
        alertEl.className="form-alert success show";
        document.getElementById("contactName").value="";
        document.getElementById("contactEmailInput").value="";
        document.getElementById("contactSubject").value="";
        document.getElementById("contactMessage").value="";
      } catch(error) { alertEl.textContent="Failed to send. Please try again."; alertEl.className="form-alert error show"; }
    });

    loadCategories(); loadCourses(); loadAnnouncements(); loadStats();

    // ===== Login + one-time First Super Admin (added) =====
    const auth = getAuth(app);

    // Dashboard page for each role. Change a file name here if yours is different.
    const DASHBOARDS = {
      student: "student-dashboard.html",
      teacher: "teacher-dashboard.html",
      admin: "#admin",
      super_admin: "#admin"
    };
    const ROLE_LABELS = { student:"Student", teacher:"Teacher", admin:"Admin", super_admin:"Super Admin" };

    const byId = (id) => document.getElementById(id);
    const loginAlert = byId("loginAlert");
    function setAlert(type, msg) { loginAlert.textContent = msg; loginAlert.className = "form-alert " + type + " show"; }
    function clearAlert() { loginAlert.className = "form-alert"; }

    function normRole(r) {
      r = String(r || "").toLowerCase().replace(/[\s-]+/g, "_");
      return r === "superadmin" ? "super_admin" : r;
    }

    function applyRoute(scroll) {
      const isLogin = location.hash === "#login";
      const isAdmin = location.hash === "#admin";
      document.documentElement.classList.toggle("is-login", isLogin);
      document.documentElement.classList.toggle("is-admin", isAdmin);
      byId("mobileNav").classList.remove("show");
      if (isAdmin) { window.scrollTo(0, 0); return; }
      if (isLogin) { window.scrollTo(0, 0); refreshSetupState(); }
      else if (scroll && location.hash.length > 1) {
        try { const el = document.querySelector(location.hash); if (el) el.scrollIntoView(); } catch (e) {}
      }
    }
    window.addEventListener("hashchange", () => applyRoute(true));

    // The Super Admin option is shown only when setup is confirmed NOT completed.
    async function refreshSetupState() {
      let show = false;
      try {
        const snap = await getDoc(doc(db, "system", "initialSetup"));
        show = !snap.exists();
      } catch (e) { show = false; }
      byId("saSection").hidden = !show;
    }

    document.querySelectorAll(".pw-toggle").forEach(btn => {
      btn.addEventListener("click", () => {
        const input = byId(btn.dataset.target);
        const reveal = input.type === "password";
        input.type = reveal ? "text" : "password";
        btn.textContent = reveal ? "Hide" : "Show";
      });
    });

    async function dashboardExists(url) {
      try { const r = await fetch(url, { method: "HEAD", cache: "no-store" }); return r.ok; }
      catch (e) { return false; }
    }

    // Verifies the role, then redirects to the matching dashboard.
    async function routeUser(user) {
      const tokenRes = await user.getIdTokenResult(true);
      const claims = tokenRes.claims || {};
      let role = normRole(claims.role);
      if (claims.super_admin === true || claims.superAdmin === true) role = "super_admin";

      let profile = null;
      try {
        const snap = await getDoc(doc(db, "users", user.uid));
        if (snap.exists()) profile = snap.data();
      } catch (e) {}

      if (profile) {
        const status = String(profile.status || "active").toLowerCase();
        if (["suspended", "disabled", "deleted"].includes(status)) {
          await signOut(auth);
          const err = new Error("This account is suspended. Contact the administrator."); err.custom = true; throw err;
        }
        if (normRole(profile.role) === "super_admin") role = "super_admin";
        else if (!role) role = normRole(profile.role);
      }

      if (!DASHBOARDS[role]) {
        await signOut(auth);
        const err = new Error("No role is assigned to this account. Contact the administrator."); err.custom = true; throw err;
      }

      const url = DASHBOARDS[role];
      if (url && String(url).startsWith("#")) {
        document.documentElement.classList.remove("is-login");
        document.documentElement.classList.add("is-admin");
        if (location.hash !== "#admin") location.hash = "admin";
        window.scrollTo(0, 0);
        return;
      }
      if (await dashboardExists(url)) { window.location.href = url; return; }

      // Dashboard page not found: confirm the login instead of a dead link.
      byId("loginForm").hidden = true;
      byId("saSection").hidden = true;
      byId("signedInPanel").hidden = false;
      const name = (profile && profile.fullName) || user.email;
      byId("signedInText").textContent = "Login successful. Signed in as " + name + " (" + ROLE_LABELS[role] + "). The dashboard page " + url + " was not found.";
      setAlert("success", "Login successful.");
    }

    function authError(e) {
      if (e && e.custom) return e.message;
      switch (e && e.code) {
        case "auth/invalid-credential":
        case "auth/wrong-password":
        case "auth/user-not-found": return "Incorrect email or password.";
        case "auth/invalid-email": return "Enter a valid email address.";
        case "auth/user-disabled": return "This account has been disabled. Contact the administrator.";
        case "auth/too-many-requests": return "Too many attempts. Wait a few minutes and try again.";
        case "auth/network-request-failed": return "Network error. Check your connection and try again.";
        case "auth/operation-not-allowed": return "Email/Password sign-in is off. Turn it on in Firebase Console → Authentication → Sign-in method.";
        case "auth/email-already-in-use": return "This email already has an account. Delete it in Firebase Authentication first, or use another email.";
        case "auth/weak-password": return "Password is too weak. Use at least 8 characters.";
        default: return "Something went wrong. Try again.";
      }
    }

    byId("loginBtn").addEventListener("click", async () => {
      const email = byId("loginEmail").value.trim();
      const password = byId("loginPassword").value;
      if (!email || !password) return setAlert("error", "Enter your email and password.");
      const btn = byId("loginBtn");
      btn.disabled = true; btn.textContent = "Logging in…"; clearAlert();
      try {
        const cred = await signInWithEmailAndPassword(auth, email, password);
        await routeUser(cred.user);
      } catch (e) { setAlert("error", authError(e)); }
      finally { btn.disabled = false; btn.textContent = "Login"; }
    });
    byId("loginPassword").addEventListener("keydown", (e) => { if (e.key === "Enter") byId("loginBtn").click(); });

    byId("forgotBtn").addEventListener("click", async () => {
      const email = byId("loginEmail").value.trim();
      if (!email) return setAlert("error", "Enter your email address above first.");
      try {
        await sendPasswordResetEmail(auth, email);
        setAlert("success", "If an account exists for this email, a reset link has been sent.");
      } catch (e) { setAlert("error", authError(e)); }
    });

    byId("logoutBtn").addEventListener("click", async () => {
      try { await signOut(auth); } catch (e) {}
      byId("signedInPanel").hidden = true;
      byId("loginForm").hidden = false;
      byId("loginPassword").value = "";
      clearAlert();
      refreshSetupState();
    });

    byId("saToggleBtn").addEventListener("click", () => {
      byId("saForm").hidden = !byId("saForm").hidden;
    });

    byId("saCreateBtn").addEventListener("click", async () => {
      const fullName = byId("saName").value.trim();
      const email = byId("saEmail").value.trim().toLowerCase();
      const password = byId("saPassword").value;
      const confirm = byId("saConfirm").value;
      const key = byId("saKey").value.trim();

      if (!fullName || !email || !password || !confirm || !key) return setAlert("error", "Fill in all Super Admin fields.");
      if (!/^[A-Za-z0-9_-]{8,64}$/.test(key)) return setAlert("error", "Setup Key is not valid.");
      if (password.length < 8) return setAlert("error", "Password must be at least 8 characters.");
      if (password !== confirm) return setAlert("error", "Passwords do not match.");

      const btn = byId("saCreateBtn");
      btn.disabled = true; btn.textContent = "Creating…"; clearAlert();

      let cred;
      try {
        cred = await createUserWithEmailAndPassword(auth, email, password);
      } catch (e) {
        btn.disabled = false; btn.textContent = "Create Super Admin";
        return setAlert("error", authError(e));
      }

      try {
        const batch = writeBatch(db);
        batch.set(doc(db, "users", cred.user.uid), {
          uid: cred.user.uid, fullName, email: cred.user.email,
          role: "super_admin", status: "active", createdBy: "first-setup",
          createdAt: serverTimestamp(), updatedAt: serverTimestamp()
        });
        batch.set(doc(db, "system", "initialSetup"), {
          status: "completed", completedAt: serverTimestamp(), setupKey: key
        });
        await batch.commit();
      } catch (e) {
        try { await cred.user.delete(); } catch (_) {}
        btn.disabled = false; btn.textContent = "Create Super Admin";
        const denied = e && (e.code === "permission-denied" || /permission/i.test(e.message || ""));
        return setAlert("error", denied
          ? "Not allowed: the Setup Key is wrong, the rules are not published, or setup was already completed."
          : "Could not save the Super Admin profile. Try again.");
      }

      // Setup is done: remove the option permanently and sign in.
      byId("saSection").hidden = true;
      byId("saForm").hidden = true;
      setAlert("success", "Super Admin created. Signing you in…");
      try { await routeUser(cred.user); } catch (e) { setAlert("error", authError(e)); }
    });

    applyRoute(false);
  </script>

  <script type="module">

    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-app.js";
    import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-auth.js";
    import {
      getFirestore, collection, getDocs, getDoc, addDoc, setDoc, updateDoc, deleteDoc,
      doc, query, where, orderBy, limit, serverTimestamp, writeBatch
    } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: "AIzaSyBlEw1Pb5HzIePo5SlolYm9ofvCUSBS0wM",
      authDomain: "mmsayaya-academy.firebaseapp.com",
      projectId: "mmsayaya-academy",
      storageBucket: "mmsayaya-academy.firebasestorage.app",
      messagingSenderId: "261003419792",
      appId: "1:261003419792:web:9710d497a942a92c10b815",
      measurementId: "G-0N2Q1V11LG"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);

    // ---------- Auth gate ----------
    let currentUser = null;
    let currentProfile = null;

    onAuthStateChanged(auth, async (user) => {
      if (!user) {
        document.documentElement.classList.remove("is-admin");
        if (location.hash === "#admin") location.hash = "#login";
        return;
      }
      currentUser = user;
      try {
        const snap = await getDoc(doc(db, "users", user.uid));
        if (snap.exists()) {
          currentProfile = snap.data();
          const role = String(currentProfile.role || "").toLowerCase().replace(/[\s-]+/g, "_");
          if (role !== "admin" && role !== "super_admin") {
            document.documentElement.classList.remove("is-admin");
            if (location.hash === "#admin") {
              try { await signOut(auth); } catch (_) {}
              location.hash = "#login";
            }
            return;
          }
          document.documentElement.classList.add("is-admin");
          document.getElementById("adminName").textContent = currentProfile.fullName || user.email;
          document.getElementById("adminRole").textContent = role === "super_admin" ? "Super Admin" : "Admin";
          document.getElementById("adminAvatar").textContent = (currentProfile.fullName || "A").charAt(0).toUpperCase();
          document.getElementById("profileName").value = currentProfile.fullName || "";
          document.getElementById("profileEmail").value = user.email || "";
        } else {
          document.getElementById("adminName").textContent = user.email;
        }
      } catch (e) {
        console.warn("Profile load:", e);
      }
      loadOverview();
    });

